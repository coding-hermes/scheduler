# Binaries
bin/
# RELEASE-037: release build output. The release workflow now writes to
# $RUNNER_TEMP/dist so the checkout stays pristine (Go's VCS stamping reads
# the tree, and untracked binaries there stamped 7 of 8 assets +dirty at
# v1.14.0). Ignoring dist/ additionally keeps a local `mkdir -p dist` build
# from dirtying the tree.
dist/

# Generated / accidental-at-root artifacts (CLN-1 2026-09-26: both of these were
# committed by accident — coverage.html in b736d12b, a 0-byte scheduler.db in
# 9cb721e9. The live DB is ~/.hermes/coding-hermes/scheduler.db, never the repo.)
/coverage.html
/scheduler.db

# Test coverage
*.out
*.test

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Deployment verification logs
deploy/*.log

# Goose migrations (if using goose)
# goose/version/

# Project-local state (not committed)
.vfs/
.coding-hermes/*
!.coding-hermes/tasks.md
!.coding-hermes/tasks.md.bak
!.coding-hermes/board/
!.coding-hermes/board/schema.sql
.coding-hermes/board/*.db
!.coding-hermes/research/
!.coding-hermes/research/brin-index-design.md
!.coding-hermes/tests/
!.coding-hermes/tests/_index.md
!.coding-hermes/tests/test-state.toml
.gitreins/history/
dagger.db
dagger.db-wal
dagger.db-shm
*.db-wal
*.db-shm
/schedulerd

.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal
.coding-hermes/board/*.parquet
.coding-hermes/board/*.duckdb
/.gitreins/usage.jsonl

# Live fleet config — deliberately NOT tracked. The source of truth is the
# live file ~/.hermes/fleet.toml on the scheduler host, written only by
# ~/.hermes/scripts/fleet-cooldown-policy.py --apply. It is regenerated
# constantly, so a tracked copy here goes stale immediately (SCHED-GAP-213).
/fleet.toml

# Untracked tick scratch (untracked noise every tick)
tmp/
.gitreins/logs/
.gitreins/*.lock

# RELEASE-048 arm 3: the release claim marker is RUNTIME state, not repo
# truth — a marker present in the tree would also fail `make tag`'s
# clean-tree precondition. The claim protocol lives in
# scripts/release-claim.sh + docs/releases.md §8.
.coding-hermes/board/release-claim.json
.coding-hermes/board/release-claim.json.lock

# Python bytecode / pytest caches (tests/ drives ops/check-fleet-invariants.py in-process)
__pycache__/
.pytest_cache/

# Live config file, not repo truth (SCHED-GAP-213)
fleet.toml
