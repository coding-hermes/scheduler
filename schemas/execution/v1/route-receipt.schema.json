{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coding-hermes.dev/schemas/execution/v1/route-receipt.schema.json","title":"Task-router route receipt v1","type":"object","additionalProperties":false,
  "required":["schema_version","route_receipt_id","task_id","created_at","candidates","exclusions","route_digest"],
  "properties":{"schema_version":{"const":"1.0"},"route_receipt_id":{"$ref":"#/$defs/s"},"task_id":{"$ref":"#/$defs/s"},"created_at":{"type":"string","format":"date-time"},"candidates":{"type":"array","items":{"$ref":"#/$defs/candidate"}},"exclusions":{"type":"array","items":{"$ref":"#/$defs/exclusion"}},"route_digest":{"$ref":"#/$defs/digest"}},
  "$defs":{"s":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"money":{"type":"object","additionalProperties":false,"required":["currency","microunits"],"properties":{"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"microunits":{"type":"integer","minimum":0}}},"candidate":{"type":"object","additionalProperties":false,"required":["rank","model","provider","base_url","capability_score","verified_outcome","effective_price","quota_state","health","circuit_state"],"properties":{"rank":{"type":"integer","minimum":1},"model":{"$ref":"#/$defs/s"},"provider":{"$ref":"#/$defs/s"},"base_url":{"type":"string","format":"uri"},"capability_score":{"type":"integer","minimum":0},"verified_outcome":{"enum":["passed","failed","unknown"]},"effective_price":{"$ref":"#/$defs/money"},"quota_state":{"enum":["available","limited","exhausted","unknown"]},"health":{"enum":["healthy","degraded","unavailable","unknown"]},"circuit_state":{"enum":["closed","open","half_open"]}}},"exclusion":{"type":"object","additionalProperties":false,"required":["model","provider","reason"],"properties":{"model":{"$ref":"#/$defs/s"},"provider":{"$ref":"#/$defs/s"},"reason":{"enum":["capability","policy","price","quota","health","circuit"]}}}}
}
