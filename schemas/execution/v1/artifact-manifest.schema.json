{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coding-hermes.dev/schemas/execution/v1/artifact-manifest.schema.json","title":"Artifact manifest and reference v1","type":"object","additionalProperties":false,
  "required":["schema_version","manifest_id","run_id","attempt_id","artifacts","manifest_digest"],"properties":{"schema_version":{"const":"1.0"},"manifest_id":{"$ref":"#/$defs/s"},"run_id":{"$ref":"#/$defs/s"},"attempt_id":{"$ref":"#/$defs/s"},"artifacts":{"type":"array","items":{"$ref":"#/$defs/artifact"}},"manifest_digest":{"$ref":"#/$defs/digest"}},
