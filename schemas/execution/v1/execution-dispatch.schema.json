{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://coding-hermes.dev/schemas/execution/v1/execution-dispatch.schema.json","title":"Scheduler execution.dispatch envelope v1","type":"object","additionalProperties":false,
