{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-hermes.dev/schemas/execution/v1/execution-brief.schema.json",
  "title": "ExecutionBrief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "revision_id", "issued_at", "issued_by", "project", "lane", "task_id", "tick_id", "mission", "rationale_summary", "source", "context_refs", "scope", "constraints", "non_goals", "capability_requirements", "workspace_policy", "permission_policy", "resource_policy", "acceptance_criteria", "required_deliverables", "closeout_policy", "provenance", "brief_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "brief_id": {"$ref": "#/$defs/id"}, "revision_id": {"$ref": "#/$defs/id"},
    "issued_at": {"$ref": "#/$defs/time"}, "issued_by": {"$ref": "#/$defs/nonempty"},
    "project": {"$ref": "#/$defs/nonempty"}, "lane": {"$ref": "#/$defs/nonempty"},
    "task_id": {"$ref": "#/$defs/id"}, "tick_id": {"$ref": "#/$defs/id"},
    "mission": {"$ref": "#/$defs/nonempty"}, "rationale_summary": {"$ref": "#/$defs/nonempty"},
    "source": {"$ref": "#/$defs/source"},
    "context_refs": {"type": "array", "items": {"$ref": "#/$defs/context_ref"}},
    "scope": {"$ref": "#/$defs/scope"},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "non_goals": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
    "capability_requirements": {"$ref": "#/$defs/capabilities"},
    "workspace_policy": {"$ref": "#/$defs/workspace_policy"},
    "permission_policy": {"$ref": "#/$defs/permission_policy"},
    "resource_policy": {"$ref": "#/$defs/resource_policy"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "required_deliverables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
    "closeout_policy": {"$ref": "#/$defs/closeout_policy"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "brief_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "time": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository_uri", "source_ref", "base_revision", "diff_base_revision"], "properties": {"repository_uri": {"type": "string", "format": "uri"}, "source_ref": {"$ref": "#/$defs/nonempty"}, "base_revision": {"$ref": "#/$defs/nonempty"}, "diff_base_revision": {"$ref": "#/$defs/nonempty"}}},
    "context_ref": {"type": "object", "additionalProperties": false, "required": ["namespace", "key_or_id", "revision_or_digest", "retrieved_at", "authority"], "properties": {"namespace": {"$ref": "#/$defs/nonempty"}, "key_or_id": {"$ref": "#/$defs/nonempty"}, "revision_or_digest": {"$ref": "#/$defs/nonempty"}, "retrieved_at": {"$ref": "#/$defs/time"}, "authority": {"enum": ["authoritative", "advisory"]}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["allowed_paths", "forbidden_paths"], "properties": {"allowed_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}, "forbidden_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}}}},
    "constraint": {"type": "object", "additionalProperties": false, "required": ["id", "level", "statement"], "properties": {"id": {"$ref": "#/$defs/id"}, "level": {"enum": ["must", "must_not", "should", "should_not"]}, "statement": {"$ref": "#/$defs/nonempty"}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["required", "optional"], "properties": {"required": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}, "optional": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}}},
    "capability": {"enum": ["steer", "resume", "cancel", "input", "approval", "quiescence", "structured_output", "mcp", "background_work"]},
    "workspace_policy": {"type": "object", "additionalProperties": false, "required": ["kind", "isolation", "network", "required_tools"], "properties": {"kind": {"enum": ["git_worktree"]}, "isolation": {"enum": ["bunker"]}, "network": {"enum": ["none", "restricted"]}, "required_tools": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}}},
    "permission_policy": {"type": "object", "additionalProperties": false, "required": ["profile", "unattended", "approval_timeout_s"], "properties": {"profile": {"enum": ["read_only", "workspace_write"]}, "unattended": {"type": "boolean"}, "approval_timeout_s": {"type": "integer", "minimum": 0}}},
    "resource_policy": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory_mb", "pids", "disk_mb", "wall_timeout_s", "idle_timeout_s"], "properties": {"cpu": {"type": "integer", "minimum": 1}, "memory_mb": {"type": "integer", "minimum": 1}, "pids": {"type": "integer", "minimum": 1}, "disk_mb": {"type": "integer", "minimum": 1}, "wall_timeout_s": {"type": "integer", "minimum": 1}, "idle_timeout_s": {"type": "integer", "minimum": 1}}},
    "criterion": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "required", "proof_requirements"], "properties": {"id": {"$ref": "#/$defs/id"}, "statement": {"$ref": "#/$defs/nonempty"}, "required": {"type": "boolean"}, "proof_requirements": {"type": "array", "items": {"$ref": "#/$defs/proof"}}}, "allOf": [{"if": {"properties": {"required": {"const": true}}, "required": ["required"]}, "then": {"properties": {"proof_requirements": {"minItems": 1}}}}]},
    "proof": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "argv", "cwd", "timeout_s", "expect_exit", "expected_artifact"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["command", "test", "build", "lint", "gitreins", "artifact"]}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cwd": {"$ref": "#/$defs/path"}, "timeout_s": {"type": "integer", "minimum": 1}, "expect_exit": {"type": "integer", "minimum": 0, "maximum": 255}, "expected_artifact": {"type": ["string", "null"]}}},
    "closeout_policy": {"type": "object", "additionalProperties": false, "required": ["requires_commit", "requires_source_or_test_diff", "target_remote", "target_branch"], "properties": {"requires_commit": {"type": "boolean"}, "requires_source_or_test_diff": {"type": "boolean"}, "target_remote": {"$ref": "#/$defs/nonempty"}, "target_branch": {"$ref": "#/$defs/nonempty"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["foreman_run_id", "board_revision"], "properties": {"foreman_run_id": {"$ref": "#/$defs/id"}, "board_revision": {"$ref": "#/$defs/nonempty"}}}
  }
}
